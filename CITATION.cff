  - Apache-2.0
license-url: "https://github.com/dnv2003/v100-skinny/blob/main/LICENSE"
repository-code: "https://github.com/dnv2003/v100-skinny"
keywords:
  - inference
  - quantization
  - NVFP4
  - FP8
  - Volta
  - SM70
  - speculative-decoding
  - vLLM
